/* ============================================================
   RÉSUMÉ GLOBAL — hero + cartes vedettes + compteurs
   À coller à la fin de content/css/modules/hub.css
   (juste avant la media query existante, ou après : les
   sélecteurs ne se croisent pas avec l'existant)

   Ne supprime PAS .hub-summary : games-table.css s'en sert.
   ============================================================ */

.hub-global {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* ------------------------------------------------------------
   Étage 1 — le chiffre héros
   ------------------------------------------------------------ */

.hub-hero {
    padding: 24px;
    background: linear-gradient(145deg, #2f2f38, #232329);
    border: 1px solid #3a3a45;
    border-radius: 14px;
}

.hero-label {
    display: block;
    margin-bottom: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #8f8fa5;
}

.hero-line {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
}

.hero-value {
    font-size: 52px;
    font-weight: 800;
    line-height: 1;
    color: #b3a0ff;
}

.hero-unit {
    font-size: 20px;
    color: #8f8fa5;
}

.hero-aside {
    margin-left: auto;
    font-size: 13px;
    color: #6f6f85;
}

.hero-bar {
    display: flex;
    height: 10px;
    margin: 18px 0 10px;
    background: #1f1f26;
    border-radius: 5px;
    overflow: hidden;
}

.hero-seg {
    transition: width 0.4s ease;
}

.hero-legend {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 12px;
    color: #8f8fa5;
}

.hero-leg i {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 2px;
}

.hero-leg--muted {
    color: #5f5f70;
    font-style: italic;
}

/* ------------------------------------------------------------
   Étage 2 — cartes vedettes
   ------------------------------------------------------------ */

.hub-featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
    align-items: start;
}

.feature-card {
    padding: 16px;
    background: #2a2a33;
    border: 1px solid #3a3a45;
    border-radius: 14px;
}

.feature-label {
    display: block;
    margin-bottom: 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #8f8fa5;
}

.feature-visual {
    height: 60px;
    margin-bottom: 12px;
    background: #1f1f26;
    border: 1px solid #33333d;
    border-radius: 8px;
    overflow: hidden;
}

.feature-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.feature-visual--rank {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(124, 92, 255, 0.12);
    border-color: #4a3f7a;
}

.rank-badge {
    font-size: 17px;
    font-weight: 800;
    color: #b3a0ff;
}

.feature-title {
    margin: 0 0 3px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
}

.feature-sub {
    margin: 0;
    font-size: 13px;
    color: #8f8fa5;
}

.feature-sub strong {
    color: #b3a0ff;
    font-weight: 600;
}

/* --- Carte "Ces 2 semaines" : top 3 des jeux de la période --- */

.recent-total {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 14px;
}

.recent-value {
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    color: #b3a0ff;
}

.recent-unit {
    font-size: 14px;
    color: #8f8fa5;
}

.recent-row {
    margin-bottom: 10px;
}

.recent-row:last-child {
    margin-bottom: 0;
}

.recent-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
    font-size: 13px;
}

.recent-name {
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.recent-hours {
    flex-shrink: 0;
    margin-left: 10px;
    color: #8f8fa5;
}

.recent-track {
    height: 5px;
    background: #1f1f26;
    border-radius: 3px;
}

.recent-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.4s ease;
}

/* ------------------------------------------------------------
   Étage 3 — compteurs secondaires
   ------------------------------------------------------------ */

.hub-counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 16px;
    padding: 18px 20px;
    background: #2a2a33;
    border: 1px solid #3a3a45;
    border-radius: 14px;
}

/* .summary-box / .summary-value / .summary-label viennent déjà de hub.css */
.hub-counters .summary-value {
    font-size: 22px;
}

/* ------------------------------------------------------------
   Responsive
   ------------------------------------------------------------ */

@media (max-width: 720px) {
    .hub-hero {
        padding: 20px;
    }

    .hero-value {
        font-size: 38px;
    }

    .hero-aside {
        flex-basis: 100%;
        margin-left: 0;
    }

    .hero-legend {
        gap: 10px;
        flex-direction: column;
    }
}

@media (prefers-reduced-motion: reduce) {
    .hero-seg,
    .recent-fill {
        transition: none;
    }
}